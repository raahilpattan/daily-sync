{
  "manifest_version": 3,
  "name": "Daily Sync",
  "short_name": "Daily Sync",
  "version": "1.2.0",
  "description": "Automatically track your daily puzzle progress, stay organized, and compare results with friends.",
  "key": "",
  "permissions": ["storage", "alarms", "identity"],
  "oauth2": {
    "client_id": "889622447436-n9fhcejjvuu0670lf08lghi7pbm2vrhl.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/userinfo.profile",
      "https://www.googleapis.com/auth/userinfo.email"
    ]
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Daily Sync",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.nytimes.com/games/wordle/*",
        "https://www.nytimes.com/games/connections*",
        "https://www.nytimes.com/games/strands*",
        "https://globle-game.com/*",
        "https://*.globle-game.com/*",
        "https://worldle.teuteuf.fr/*",
        "https://krillion.io/*"
      ],
      "js": ["content/page-hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.nytimes.com/games/wordle/*"],
      "js": ["content/common.js", "content/games/wordle.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.nytimes.com/games/connections*"],
      "js": ["content/common.js", "content/games/connections.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.nytimes.com/games/strands*"],
      "js": ["content/common.js", "content/games/strands.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://globle-game.com/*", "https://*.globle-game.com/*"],
      "js": ["content/common.js", "content/games/globle.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://worldle.teuteuf.fr/*"],
      "js": ["content/common.js", "content/games/worldle.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://krillion.io/*"],
      "js": ["content/common.js", "content/games/krillion.js"],
      "run_at": "document_idle"
    }
  ]
}
